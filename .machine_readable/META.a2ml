#
# META.a2ml — Project meta-level information
# Architecture decisions, design rationale, governance.

[metadata]
version = "0.1.0"
last-updated = "2026-03-16"

[project-info]
type = "binary"  # Rust workspace producing har-cli binary + har-core/har-router libraries
languages = ["rust", "zig", "idris2", "ephapax", "gleam"]
license = "PMPL-1.0-or-later"
author = "Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>"
standard = "RSR 2026"

[architecture-decisions]
# ADR format: status = proposed | accepted | deprecated | superseded | rejected

ADR-001 = { title = "Rust core with pluggable routing strategies", status = "accepted", date = "2026-03-16", rationale = "Trait-based strategy pattern allows hot-swappable routing without recompilation. Rust provides memory safety and zero-cost abstractions for high-throughput event dispatch." }

ADR-002 = { title = "proven-fsm for router lifecycle management", status = "accepted", date = "2026-03-16", rationale = "Formally verified finite state machine ensures the router transitions through valid states only (init, ready, routing, draining, stopped). Eliminates invalid-state bugs." }

ADR-003 = { title = "proven-queueconn for target dispatch", status = "accepted", date = "2026-03-16", rationale = "Queue-based dispatch decouples the router from targets, enabling backpressure, retry, and dead-letter handling with formal guarantees." }

ADR-004 = { title = "Ephapax linear types for ownership safety", status = "accepted", date = "2026-03-16", rationale = "Linear types guarantee exactly-once event delivery — an event cannot be duplicated or dropped silently. Critical for automation correctness." }

ADR-005 = { title = "rpa-elysium as first-class integration target", status = "accepted", date = "2026-03-16", rationale = "RPA Elysium is the primary consumer of routed events. HAR's target interface is designed around rpa-elysium's bot framework API, with panels/ providing dedicated monitoring." }

ADR-006 = { title = "PanLL panels for monitoring and dashboards", status = "accepted", date = "2026-03-16", rationale = "PanLL's panel-based architecture provides live data sources for route health, dispatch latency, and target status without building a custom dashboard." }

[development-practices]
build-tool = "just"
container-runtime = "podman"
ci-platform = "github-actions"
package-manager = "cargo"  # Rust workspace; guix for system-level

[maintenance-axes]
scoping-first = true
execution-order = "axis-1 > axis-2 > axis-3"
axis-1 = "must > intend > like"
axis-2 = "corrective > adaptive > perfective"
axis-3 = "systems > compliance > effects"

[scoping]
sources = "README, roadmap, status docs, maintenance checklist, CI/security docs"
marker-scan = "TODO/FIXME/XXX/HACK/STUB/PARTIAL"
idris-unsound-scan = "believe_me/assert_total"

[axis-2-maintenance-rules]
corrective-first = true
adaptive-second = true
adaptive-focus = "scope-change reconciliation, stale-reference removal, obsolete-work culling"
perfective-third = true
perfective-source = "axis-1 honest state after corrective/adaptive updates"

[axis-3-audit-rules]
audit-focus = "systems in place, documentation explains actual state, safety/security accounted for, observed effects reviewed"
compliance-focus = "seams/compromises/exception register, bounded exceptions, anti-drift checks"
drift-risk-example = "single exception broadening into policy violation (e.g. ReScript->TypeScript spread)"
effects-evidence = "benchmark execution/results and maintainer status dialogue/review"

[design-rationale]
# Key design decisions and their reasoning
routing-architecture = "Event sources push to the router, which applies a chain of strategies (score, balance, circuit-break) before dispatching to a target via queueconn."
target-abstraction = "Targets implement a trait (AutomationTarget) so the router is target-agnostic — rpa-elysium, API, desktop, and document targets all conform."
abi-ffi-split = "Idris2 defines the ABI with dependent-type proofs; Zig implements the C-compatible FFI. This separates correctness (Idris2) from performance (Zig)."
