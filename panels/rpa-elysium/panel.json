{
  "$schema": "panll-panel/v1",
  "panel_id": "har-rpa-elysium-status",
  "name": "RPA Elysium Status",
  "description": "Real-time status panel for rpa-elysium automation target within HAR",
  "version": "0.1.0",
  "category": "automation",
  "layout": {
    "type": "grid",
    "columns": 3,
    "rows": 4,
    "gap": "8px"
  },
  "widgets": [
    {
      "id": "target-health",
      "type": "status-indicator",
      "position": { "col": 1, "row": 1, "span_cols": 1 },
      "label": "Target Health",
      "data_source": "har://targets/rpa-elysium/status",
      "states": {
        "healthy": { "color": "#22c55e", "icon": "check-circle" },
        "degraded": { "color": "#f59e0b", "icon": "alert-triangle" },
        "unhealthy": { "color": "#ef4444", "icon": "x-circle" },
        "unknown": { "color": "#6b7280", "icon": "help-circle" }
      }
    },
    {
      "id": "events-routed",
      "type": "counter",
      "position": { "col": 2, "row": 1, "span_cols": 1 },
      "label": "Events Routed",
      "data_source": "har://targets/rpa-elysium/metrics/events_routed",
      "format": "number"
    },
    {
      "id": "routing-confidence",
      "type": "gauge",
      "position": { "col": 3, "row": 1, "span_cols": 1 },
      "label": "Avg Confidence",
      "data_source": "har://targets/rpa-elysium/metrics/avg_confidence",
      "min": 0.0,
      "max": 1.0,
      "format": "percentage"
    },
    {
      "id": "workflow-list",
      "type": "table",
      "position": { "col": 1, "row": 2, "span_cols": 3, "span_rows": 2 },
      "label": "Active Workflows",
      "data_source": "rpa-elysium://workflows/active",
      "columns": [
        { "key": "name", "label": "Workflow" },
        { "key": "status", "label": "Status" },
        { "key": "events_processed", "label": "Events" },
        { "key": "actions_executed", "label": "Actions" },
        { "key": "error_count", "label": "Errors" }
      ]
    },
    {
      "id": "recent-events",
      "type": "event-log",
      "position": { "col": 1, "row": 4, "span_cols": 3 },
      "label": "Recent Routed Events",
      "data_source": "har://targets/rpa-elysium/events/recent",
      "max_entries": 20,
      "show_timestamp": true,
      "show_category": true
    }
  ],
  "refresh_interval_ms": 5000,
  "permissions": ["read:targets", "read:events", "read:metrics"]
}
