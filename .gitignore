# RSR-compliant .gitignore

# OS & Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Build
/target/
/_build/
/build/
/dist/

# Rust
# Cargo.lock  # Keep for binaries

# Zig
/ffi/zig/zig-cache/
/ffi/zig/zig-out/
/ffi/zig/.zig-cache/

# Idris2
/src/abi/build/
/src/abi/.idris2/

# Generated ABI headers
/generated/abi/*.h

# Gleam
/services/build/
/services/_gleam_artefacts/

# Deno
/.deno/
/deno.lock

# ReScript
/lib/bs/
/.bsb.lock
*.res.mjs

# Secrets
.env
.env.*
*.pem
*.key
secrets/

# Test/Coverage
/coverage/

# Logs
*.log
/logs/

# Temp
/tmp/
*.tmp
*.bak
